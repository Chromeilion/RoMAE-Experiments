# Example environment variables for pre-training or fine-tuning
ELASTICC_DATASET_LOCATION=./elasticc_final.h5
ELASTICC_MODEL_SIZE=RoMAE-tiny-shallow # Could also be, e.g., RoMAE-tiny or RoMAE-base

# Example Pre-training hyperparameters
ELASTICC_PRETRAIN_BATCH_SIZE=1024

# Example Fine-tuning hyperparameters
ELASTICC_FINETUNE_BATCH_SIZE=512
ELASTICC_PRETRAINED_MODEL=./pretrained_checkpoint

# Model parameters like dropout can be set through the RoMAE package env vars
ROMAE_CLASSIFIER_ENCODER_CONFIG__ATTN_DROP_RATE=0.2
ROMAE_CLASSIFIER_ENCODER_CONFIG__HIDDEN_DROP_RATE=0.2
ROMAE_CLASSIFIER_ENCODER_CONFIG__DROP_PATH_RATE=0.2

# RoMAE Trainer hyperparameters
ROMAE_TRAINER_NUM_DATASET_WORKERS=8

